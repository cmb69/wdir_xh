<?xml version="1.0" encoding="UTF-8"?>

<project name="Wdir" default="help">

    <fileset id="php-sources" dir=".">
        <include name="classes/*.php"/>
        <include name="index.php"/>
    </fileset>

    <fileset id="unit-tests" dir="tests/unit">
        <include name="*Test.php"/>
    </fileset>

    <target name="help" description="lists available targets">
        <exec executable="phing" outputProperty="help">
            <arg line="-l"/>
        </exec>
        <echo>${help}</echo>
    </target>

    <target name="sniff" description="checks adherence to coding standards">
        <exec executable="phpcs" passthru="true" checkreturn="true">
            <arg line="--standard=PEAR --runtime-set ignore_warnings_on_exit true classes tests index.php"/>
        </exec>
    </target>

    <target name="unit-tests" description="runs all unit tests">
        <phpunit bootstrap="tests/autoload.php" haltonerror="true" haltonfailure="true">
            <formatter type="plain" usefile="false"/>
            <batchtest>
                <fileset refid="unit-tests"/>
            </batchtest>
        </phpunit>
    </target>

    <target name="coverage" description="generates coverage report">
        <exec executable="phpunit" logoutput="true">
            <arg line="--configuration coverage.xml"/>
        </exec>
    </target>

    <target name="build" description="builds a distributable ZIP archive">
        <fail unless="version" message="version is not defined!"/>
        <exec executable="git" checkreturn="true">
            <arg line="archive -o export.tar HEAD"/>
        </exec>
        <untar file="export.tar" todir="export"/>
        <delete file="export.tar"/>
        <jsMin targetDir="dist" suffix="" failOnError="false">
            <fileset dir="export">
                <include name="wdir.js"/>
            </fileset>
        </jsMin>
        <move todir="dist">
            <fileset dir="export">
                <exclude name="tests/**"/>
                <exclude name="build.xml"/>
                <exclude name="composer.*"/>
                <exclude name="coverage.xml"/>
                <exclude name="wdir.js"/>
            </fileset>
        </move>
        <delete dir="export"/>
        <copy file="dist/config/config.php" tofile="dist/config/defaultconfig.php"/>
        <copy file="dist/languages/en.php" tofile="dist/languages/default.php"/>
        <zip destfile="Wdir_XH-${version}.zip" basedir="dist" prefix="wdir/"/>
        <delete dir="dist"/>
    </target>

</project>
